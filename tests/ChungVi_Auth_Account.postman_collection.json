	"item": [
		{
			"name": "1. Authentication & Registration",
			"item": [
				{
					"name": "CHUNGVI-6: Register",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"username\": \"{{testUsername}}\",\n  \"full_name\": \"Nguyễn Văn A\",\n  \"phone_number\": \"0987654321\",\n  \"password\": \"SecurePassword123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"register",
								""
							]
						},
						"description": "Đăng ký tài khoản mới. Trả về thông báo thành công và yêu cầu xác thực email bằng OTP."
					},
					"response": []
				},
				{
					"name": "CHUNGVI-7: Verify registration OTP",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
