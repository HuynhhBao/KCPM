								"exec": [
									"pm.test(\"Reset Password Status Check\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 400, 404]);",
									"    if (pm.response.code === 200) {",
									"        var jsonData = pm.response.json();",
