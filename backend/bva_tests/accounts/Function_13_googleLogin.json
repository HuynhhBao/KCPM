{
    "info": {
        "_postman_id": "bva-account-function-13",
        "name": "BVA - Function 13 - googleLogin",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "TC1 - Valid token string format (but invalid to Google)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 400\", function () {",
                            "    pm.response.to.have.status(400);",
                            "});",
                            "pm.test(\"Response contains invalid token message\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.detail).to.eql(\"Google token kh\u00f4ng h\u1ee3p l\u1ec7\");",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"token\": \"dummy_valid_format_google_token\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/auth/google-login/",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "auth",
                        "google-login",
                        ""
                    ]
                }
            },
            "response": []
        },
