{
    "info": {
        "_postman_id": "bva-account-function-12",
        "name": "BVA - Function 12 - saveFCMToken",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "TC1 - Valid token and default device_type",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "pm.test(\"Response contains success message\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.message).to.eql(\"FCM token saved successfully\");",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"token\": \"valid_fcm_token_string_12345\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/auth/save-fcm-token/",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "auth",
                        "save-fcm-token",
                        ""
                    ]
                }
            },
            "response": []
        },
