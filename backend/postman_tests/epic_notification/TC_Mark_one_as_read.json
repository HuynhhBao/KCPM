            {
              "name": "Setup - Create expense (creates notification)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Status code is 201\", function () {",
                      "    pm.response.to.have.status(201);",
                      "});",
                      "var jsonData = pm.response.json();",
                      "var userAEmail = \"phuonghuynh01020304@gmail.com\";",
                      "var userBEmail = \"hoangphuongphgg@gmail.com\";",
                      "",
                      "if (jsonData.members && jsonData.members.length > 0) {",
                      "    jsonData.members.forEach(function (member) {",
                      "        var email = member.user_email || member.email || (member.user && member.user.email);",
                      "        var userId = (typeof member.user === \"object\" && member.user !== null) ? (member.user.id || member.user.user_id) : member.user;",
                      "        if (userId === undefined) {",
                      "            userId = member.user_id || member.id;",
                      "        }",
                      "        if (email === userAEmail) {",
                      "            pm.environment.set(\"userIdA\", userId);",
                      "        }",
                      "        if (email === userBEmail) {",
                      "            pm.environment.set(\"userIdB\", userId);",
                      "        }",
                      "    });",
                      "}",
                      "pm.test(\"userIdA is set\", function () {",
                      "    pm.expect(pm.environment.get(\"userIdA\")).to.not.be.undefined;",
                      "});",
                      "pm.test(\"userIdB is set\", function () {",
                      "    pm.expect(pm.environment.get(\"userIdB\")).to.not.be.undefined;",
                      "});",
                      ""
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
