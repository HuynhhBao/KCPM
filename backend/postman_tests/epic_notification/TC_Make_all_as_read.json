      "item": [
        {
          "name": "CHUNGVI-35 Mark all as read",
          "item": [
            {
              "name": "TC01 - Setup - Login user A",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// Arrange",
                      "// Precondition: user A credentials are valid and auth endpoint is reachable",
                      "var jsonData = {};",
                      "try { jsonData = pm.response.json(); } catch (e) {}",
                      "",
                      "// Act",
                      "// Login request was sent with email/password to obtain access token",
                      "",
                      "// Assert",
                      "pm.test(\"Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "pm.test(\"Has access token\", function () {",
                      "    pm.expect(jsonData).to.have.property(\"access\");",
                      "});",
                      "if (jsonData && jsonData.access) {",
                      "    pm.environment.set(\"bearerTokenA\", jsonData.access);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"phuonghuynh01020304@gmail.com\",\n  \"password\": \"phuong1234\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/login/",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "login", ""]
                }
              },
              "response": []
            },
            {
              "name": "TC02 - Setup - Verify user has notifications (unread list)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// Arrange",
                      "// Precondition: bearerTokenA is set from TC01",
                      "var jsonData = {};",
                      "try { jsonData = pm.response.json(); } catch (e) {}",
                      "",
                      "// Act",
                      "// GET notifications list filtered by is_read=false to confirm there is data to mark",
                      "",
                      "// Assert",
                      "pm.test(\"Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "var count = Array.isArray(jsonData) ? jsonData.length : (jsonData && jsonData.results ? jsonData.results.length : 0);",
                      "console.log(\"Unread notifications count:\", count);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{bearerTokenA}}" }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/notifications/?is_read=false",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "notifications", ""],
                  "query": [
                    { "key": "is_read", "value": "false" }
                  ]
                }
              },
              "response": []
            },
            {
              "name": "TC03 - Success - Mark all unread notifications as read",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// Arrange",
                      "// Precondition: user A authenticated; user may have unread notifications",
                      "var jsonData = {};",
                      "try { jsonData = pm.response.json(); } catch (e) {}",
                      "",
                      "// Act",
                      "// PATCH /api/notifications/mark-all-read/ with valid Bearer token",
                      "",
                      "// Assert",
                      "pm.test(\"Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "pm.test(\"Response has message property\", function () {",
                      "    pm.expect(jsonData).to.have.property(\"message\");",
                      "});",
                      "pm.test(\"Message indicates đánh dấu tất cả\", function () {",
                      "    var msg = (jsonData.message || \"\").toLowerCase();",
                      "    pm.expect(msg.indexOf(\"đã đánh dấu\") >= 0 || msg.indexOf(\"tất cả\") >= 0).to.be.true;",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{bearerTokenA}}" }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/notifications/mark-all-read/",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "notifications", "mark-all-read", ""]
                }
              },
              "response": []
            },
            {
