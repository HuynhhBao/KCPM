  "item": [
    {
      "name": "TC1 - Success - Update Expense",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Title is updated\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.title).to.eql(\"Updated Title\");",
              "});",
              "pm.test(\"Response time is less than 1000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/expenses/{{expense_id}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "expenses",
            "{{expense_id}}",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"Updated Title\",\n    \"amount\": \"200000\",\n    \"split_type\": \"equal\",\n    \"participants\": [\n        {\n            \"user_id\": \"{{user1_id}}\"\n        }\n    ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
