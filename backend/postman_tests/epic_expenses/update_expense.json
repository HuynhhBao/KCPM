    {
      "name": "TC6 - Logic - Update Split Type (Equal to Manual)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Split type and participant amount updated\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.split_type).to.eql(\"manual\");",
              "    pm.expect(parseFloat(jsonData.participants[0].share_amount)).to.eql(200000);",
              "});",
              "pm.test(\"Response time is less than 1000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
