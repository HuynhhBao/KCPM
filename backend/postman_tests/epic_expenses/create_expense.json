	"item": [
		{
			"name": "TC1 - Success - Split EQUAL",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"var jsonData = pm.response.json();",
							"pm.test(\"Has valid ID\", function () {",
							"    pm.expect(jsonData).to.have.property(\"id\");",
							"});",
							"",
							"pm.test(\"Check participants share amount (equal)\", function () {",
							"    pm.expect(jsonData.participants).to.be.an(\"array\").that.is.not.empty;",
							"    var sum = jsonData.participants.reduce((a, b) => a + Number(b.share_amount), 0);",
							"    pm.expect(sum).to.eql(Number(jsonData.amount));",
							"});",
							"",
							"pm.test(\"Response time is less than 1000ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(1000);",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"household\": \"{{household_id}}\",\n    \"title\": \"Ăn trưa (Chia đều)\",\n    \"amount\": 300000,\n    \"split_type\": \"equal\",\n    \"note\": \"Ăn trưa công ty\",\n    \"participants\": [\n        {\n            \"user_id\": {{user1_id}}\n        },\n        {\n            \"user_id\": {{user2_id}}\n        }\n    ]\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
